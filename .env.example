# Neon Postgres
# DATABASE_URL: Neon pooled endpoint (-pooler no host). Usado pela aplicação em dev e produção (funções serverless não devem segurar pool de conexões próprio).
DATABASE_URL=postgresql://user:password@ep-pooler.region.neon.tech/meus_livros?sslmode=require

# DATABASE_URL_DIRECT: Neon direct endpoint (sem -pooler). Apenas local para migrações (drizzle-kit) e pg_dump, pois o pooler não preserva estado de sessão necessário para DDL. Nunca configurar na Vercel.
DATABASE_URL_DIRECT=postgresql://user:password@ep-direct.region.neon.tech/meus_livros?sslmode=require

# Better Auth
# BETTER_AUTH_SECRET: Segredo aleatório de pelo menos 32 bytes (openssl rand -hex 32).
BETTER_AUTH_SECRET=your_32_character_random_secret_here
# BETTER_AUTH_URL: Origem canônica da aplicação (ex: http://localhost:3000 em dev, URL de produção na Vercel).
BETTER_AUTH_URL=http://localhost:3000

# Email OTP (SMTP Gmail via nodemailer)
# Reversão documentada em docs/architecture.md §3.5: Resend rejeita envios sem domínio próprio verificado por DNS (HTTP 403).
# EMAIL_FROM: Endereço Gmail do proprietário/remetente.
EMAIL_FROM=seu-endereco@gmail.com
# GMAIL_APP_PASSWORD: Senha de aplicativo do Google de 16 caracteres (gerada em Gerenciar Conta Google -> Segurança -> Senhas de app).
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Migração inicial / Proprietário (Consumido exclusivamente por migrate:livros)
OWNER_EMAIL=owner@example.com
OWNER_HANDLE=owner
OWNER_NAME="Nome do Proprietário"
