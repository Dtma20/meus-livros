# Copie para .env.production. Nunca commit esse arquivo preenchido.
# Os endpoints pooled e direto pertencem à mesma branch Neon de produção.
DATABASE_URL=postgresql://user:password@ep-production-pooler.sa-east-1.aws.neon.tech/livrolas?sslmode=require
# URL direta fica apenas na máquina do mantenedor; não é enviada à Vercel.
DATABASE_URL_DIRECT=postgresql://user:password@ep-production.sa-east-1.aws.neon.tech/livrolas?sslmode=require
BETTER_AUTH_SECRET=your_32_character_random_secret_here
# Use o domínio canônico efetivamente atribuído ao seu projeto livrolas.
BETTER_AUTH_URL=https://livrolas.vercel.app
EMAIL_FROM=seu-endereco@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
